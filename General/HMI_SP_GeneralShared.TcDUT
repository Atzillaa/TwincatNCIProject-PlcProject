<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="HMI_SP_GeneralShared" Id="{95dccf3d-eeed-4115-9091-b093e5a03ae7}">
    <Declaration><![CDATA[//struct to store setpoints that need te bo accessible by multiple machine parts >> this struct is stored in the general settings
{attribute 'analysis' := '-33'} //deactivate error unused variable for next variable/struct
TYPE HMI_SP_GeneralShared :
STRUCT
	(*Some example setpoints which might be needed for multiple machine parts at once*)
	
	//these setpoints could be added to setpoint group "size"
	ProductWidth:REAL;							//[group=Product] product with
	ProductHeight:REAL;							//[group=Product] product height
	
	//these setpoints could be added to a setpoint group "material
	ProductMaterialDependantSetpoint1:REAL;		//[group=Material] material setpoint xxx
	ProductMaterialDependantSetpoint2:REAL;		//[group=Material] material setpoint xxx
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>