<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="HMI_ERR" Id="{1c567b48-48e3-468e-a70d-759ef769b046}">
    <Declaration><![CDATA[(* Errors to be shown on the HMI
	rules 
		errors shall be of type bool
		errors are set and only reset if the organiser says so (this is already implemented in SCM_Template)
		errors are only for the HMI-errors (don't use for indications etc, use HMI_STS_ for that)
		errors have a explaining comment in this style:  //Error [machinepart]: my error description
			This text is used by the HMI as preliminary error text (comments for structs are not used in the HMI, only for base-types (bool))
			note: only add comments after the error. Don't make lines with only comment. Beckhoff Ads will mess up the comment for the variable when read by the HMI  
*)
TYPE HMI_ERR :
STRUCT
	General: HMI_ERR_General;									//Errors general
	
	{info 'TODO TEMPLATE REMOVE: Example scam'}
	Example:HMI_ERR_TemplateMachinePart; 						//Errors templatemachinepart 
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>