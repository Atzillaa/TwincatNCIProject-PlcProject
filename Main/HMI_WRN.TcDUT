<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="HMI_WRN" Id="{0337eeb9-53dd-48d6-b319-880cd1b0c6e4}">
    <Declaration><![CDATA[(* Warnings to be shown on the HMI
	rules 
		warnings shall be of type bool
		warnings can be SET (step condition don't forget to reset somewhere) or ACTIVATED (all steps: IO_WRN.myWarning:=I_PC_ProductLow;)
		warnings are only for the HMI-warnings (don't use for indications etc, use HMI_STS_ for that)
		warnings have a explaining comment in this style:  //Warning [machinepart]: my warning description
			This text is used by the HMI as preliminary warning text (comments for structs are not used in here we only see structs)
			note: only add comments after the warning. Don't make lines with only comment. Otherwise Beckhoff Ads will mess up the comment for the variable when read by the HMI  
*)
TYPE HMI_WRN :
STRUCT
	General: HMI_WRN_General;									//Warnings general

	{info 'TODO TEMPLATE REMOVE: Example scam'}
	Organiser:HMI_WRN_Organiser;								//Warnings organiser (If there are multiple organisers then use unique names)
	Example:HMI_WRN_TemplateMachinePart; 						//Warnings templatemachinepart
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>