<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="HMI_ERR_TemplateMachinePart" Id="{c179f755-97ec-450e-b3c8-480ebcff4cb9}">
    <Declaration><![CDATA[TYPE HMI_ERR_TemplateMachinePart :
STRUCT
	(*
		Rules:
		Errors shall only be off type BOOL
		Errors shall only be set in the program AND mass reset (utl_ANY_Reset) at I_OrgControl.Reset_K >> already programmed in the template
		
		Syntax convention:
		a clear variable name which describes the error			as described below
		InitNotEmpty:BOOL;										//Error [machinepart]: not empty during initialisation
		
		*Note the comment for structs is not used in the HMI (comments inside the struct are used), but I still recommend to add comments.
	*)
	InitNotEmpty:BOOL;										//Error [machinepart]: not empty during initialisation
	PC_ProductPassedStopper:HMI_ERR_Sensor;					//Error [machinepart]: photocel infeed
	Cil_Example: HMI_ERR_Valve;								//Error [machinepart]: cilinder1 pusher
	Cil_SlaveOfExample: HMI_ERR_Valve;						//Error [machinepart]: cilinder2 pusher
	VCG_Suckers: HMI_ERR_VacuumGenerator;					//Error [machinepart]: vacuum suckers
	Mtr_Example: HMI_ERR_Motor;								//Error [machinepart]: motor example
	Fdr_Example: HMI_ERR_FDR_CTC300;						//Error [machinepart]: Frequency drive example
	Srv_Example: HMI_ERR_Servo;								//Error [machinepart]: servo example
	Gantry_Example: HMI_ERR_SingleBeltGantry;				//Error [machinepart]: gantry example
	SrvGripper_Example: HMI_ERR_SRV_GEH6000;				//Error [machinepart]: gripper	
	Cam_OmronSmartCam: HMI_ERR_OmronMicroScan;				//Error [machinepart]: camera omron smartcam
	Cam_OmronController: HMI_ERR_OmronCamera;				//Error [machinepart]: camera omron controller
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>