  <DUT Name="HMI_STS_TemplateMachinePart" Id="{e8ac29d5-48cd-4002-9fea-0a1298a5a977}">
    <Declaration><![CDATA[{attribute 'analysis' := '-33'} //Only for template!!! >> deactivate error unused variable for next variable/struct
TYPE HMI_STS_TemplateMachinePart :
STRUCT
	IsEmpty:BOOL;												//Machinepart is empty
