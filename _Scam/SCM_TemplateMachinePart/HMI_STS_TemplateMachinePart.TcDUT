	//Template: used in HMI for test/example pages >> remove
	PB_MyButton:BOOL;										//pushbutton		>> used in HMI template for testing
	RealArr:ARRAY[0..10] OF REAL;							//arry of reals 	>> used in HMI template for testing
	MyEnum:eTMP;											//enum type 		>> test casting issues in HMI
	//used for services test
	testBool:BOOL;
	testInt:INT;
	testReal:REAL;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
