<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="sTmp" Id="{3d6e569b-8654-4cd8-959a-d643f645ce60}" SpecialFunc="None">
    <Declaration><![CDATA[(*	SCAM-State
	Lifts project unique variables to the project while keeping library functionality

	BaseBlock
		This blocks handles stuff that needs to be done @ state transitions
			-logging
			-multistepping
			-steplocking


	Usage:
		Adaptions needed to this block
		-Copy template
		-Redefine variable "eS" to your state enum
			*reasoning for var_input >> an input can be read/written to in the outside world as well as here
		
		Already done if you have copied the template
		-Finish abstract properties


	Usage in the scam:
		-This block needs to be called once before the state transitions
		-in the scam step-transitions, call the method M_Step(....) to jump to your requested state
			-in arguments define if the step can be held / log extra info
*)

FUNCTION_BLOCK sTmp EXTENDS utl_ScmState
VAR_INPUT
	eS:eTMP;  //enum holding your project unique scam-state
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^(I_OrgControl := I_OrgControl);]]></ST>
    </Implementation>
    <Property Name="P_StateAsInt" Id="{7847cc91-50a8-435d-bb75-0cd18f701b00}">
      <Declaration><![CDATA[//This property is used by the base block to manipulate eS since it doesn't know the enum type
PROPERTY P_StateAsInt : INT
]]></Declaration>
      <Get Name="Get" Id="{a47c9431-82ec-4b33-8be9-1b82950e56b9}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[P_StateAsInt := eS;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{84f3b43d-1fee-403c-a013-a4065f6898d5}">
        <Declaration><![CDATA[VAR
	pInt:pointer to int;
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[//I really want to keep attribute strict for the enum definition (to prevent enum mixing which I've seen happen) but with strict you're not allowed to assign an int which must be done here!
//so let's go evil mode... 
pInt := ADR(eS);
pInt^ := P_StateAsInt;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="P_StateAsString" Id="{2c800c99-fb5e-41b6-a88c-406b1c44ac0a}">
      <Declaration><![CDATA[//This property is used by the base block to manipulate eS since it doesn't know the enum type
PROPERTY P_StateAsString : STRING(40)]]></Declaration>
      <Get Name="Get" Id="{1a956235-2163-428f-b83a-07057a540562}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[P_StateAsString := TO_STRING(eS);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>