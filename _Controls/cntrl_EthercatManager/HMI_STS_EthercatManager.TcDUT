<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="HMI_STS_EthercatManager" Id="{efbc51cb-f021-04c8-3e06-97ccbaa697eb}">
    <Declaration><![CDATA[TYPE HMI_STS_EthercatManager :
STRUCT
	Error:BOOL;								//block in error (doesn't say anything about ethercat!)
	ErrorNr:UDINT;							//Ads error id @ error    NOTE: if in the range 16#FFFx then custom error

	IndexStatusCurrentDevice:UINT;			//setpoint index of the slave for which to get the statusses (enter manually also gets set PB next/prev not op device)
	PB_JumpIndexToNextNotOpDevice:BOOL;		//pushbutton, set index to next slave which isn't in op
	PB_JumpIndexToPreviousNotOpDevice:BOOL;	//pushbutton, set index to previous slave which isn't in op
	PB_RestartCurrentDevice:BOOL;			//pushbutton, restart currently selected device
	PB_ResetError:bool;						//pushbutton, reset block error
	StatusSlaveDevice:EcSlaveInfo;			//statusses of the given ethercat slave device

	PB_UpdateConfigAndStates:BOOL;			//pushbutton update configuration and states of all slaves
	PB_SetMasterState:BOOL;					//pushbutton set ethercat master device to given state
	ReqMasterState:eEtherCatDeviceState;	//requested state for the ethercat master @ pb set master state
	NrOfSlaves:UINT;						//number of found ethercat slaves
	NrOfSlavesNotInOp:UINT;					//number of ehtercat slaves not in op
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>