<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="HMI_SP_LayerScan" Id="{8c3e8c0a-52a2-42fa-86ce-7c774b025f88}">
    <Declaration><![CDATA[TYPE HMI_SP_LayerScan :
STRUCT
	BoardDetectFactor:REAL:=0.7;			//factor to apply to board height for finding layers/boards.   Example: if(lastHeight > (BoardDetectFactor*I_ActualHeight)) THEN newboard/layer detected
	MaxBoardGapDistance:REAL:=20;			//Max gap between boards before it is considerd a new segment  Example: if gap is bigger than this number, the previous boards can't be multipicked anymore
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>