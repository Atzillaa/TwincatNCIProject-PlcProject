<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="eLrs" Id="{687b6e59-1d18-494d-a23c-76ba8d7d5adf}">
    <Declaration><![CDATA[//enum of states
{attribute 'strict'}
{attribute 'to_string'}
{attribute 'qualified_only'}
TYPE eLrs :
(
	//NOTE @ copy of this enum, adapt existing state names:
	Disabled := -1, //-1: to make sure the code for disabling fires
	Rest,
	//Search layer
	SearchLayer,
		SearchLayerDebounceStart,
		SearchLayerDebounceEnd,
		SearchLayerDebounceNewEnd,		//layer had a gap, a new board is detected after the gap,  
	
	//Search segment
	SearchSegment,		
		SearchSegmentStartDebounce,		//height must stay above threshold during x-distance
		SearchSegmentEnd,				//wait for end detected
		SearchSegmentEndDebounce,		//gap must be bigger than gap-threshold
		SearchSegmentCheckForMore,		//if after gap distance a new segment is detected > restart

	//Search board x-endpositions
		SearchBoardX,				//store heighest found value in layer height
		SearchBoardXDone			//height dropped at least board-height
)INT;
END_TYPE

//info on attributes:
//strict 			: don't allow mixing of types
//to_string			: allows the enum to be converted to string
//qualified_only 	: forces the user to start witht the type name (to avoid the situation that accidentially another enum is used)  ]]></Declaration>
  </DUT>
</TcPlcObject>