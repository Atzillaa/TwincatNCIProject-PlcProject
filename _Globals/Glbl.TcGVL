  <GVL Name="Glbl" Id="{c945def9-01c5-4958-81b0-c5c4c71d8d05}">
    <Declaration><![CDATA[//project related global variables
{attribute 'qualified_only'}
{attribute 'analysis' := '-33'}
VAR_GLOBAL
//Variables set by Checkbounds. This function increases processor load and should be disabled once bounds problems are solved
	OutOfBounds:BOOL:=FALSE;						//Should always be false otherwise a bounds problem >> function CHECKBOUNDS must be implemented in the project, check the beckhoff help !only for testing purposes!
	OutOfBoundsIndex:DINT := 0;						//Index trying to address which was out of bounds


(*Project*)
	//TODO TEMPLATE >>
		//adapt / remove as needed
	SimEnable:BOOL:=FALSE;					//Enable simulation (when false, all simulation setpoints will be set to false
	Sim_MyMachinePart:BOOL; 				//Simulate only a part of the machine (in this case the template example)
END_VAR
// {attribute 'qualified_only'} >>forces the user to add the DUT name in front of the variables
// {attribute 'analysis' := '-33'} >>deactivate error unused variable for next variable/struct]]></Declaration>
  </GVL>
</TcPlcObject>